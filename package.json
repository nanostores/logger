{
  "name": "@nanostores/logger",
  "version": "1.0.0",
  "description": "Pretty logger of lifecycles, changes and actions for Nano Stores",
  "keywords": [
    "nanostores",
    "devtools",
    "logger",
    "store",
    "state",
    "nano"
  ],
  "scripts": {
    "demo": "vite ./demo",
    "test:lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "test:types": "check-dts",
    "test:size": "size-limit",
    "test": "pnpm --color run /^test:/"
  },
  "author": "Eduard Aksamitov <e@euaaaio.ru>",
  "license": "MIT",
  "repository": "nanostores/logger",
  "sideEffects": false,
  "type": "module",
  "types": "./index.d.ts",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "node": "^20.0.0 || >=22.0.0"
  },
  "funding": [
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoffee.com/euaaaio"
    }
  ],
  "peerDependencies": {
    "nanostores": "^0.10.0 || ^0.11.0 || ^1.0.0"
  },
  "devDependencies": {
    "@logux/eslint-config": "^57.0.2",
    "@nanostores/deepmap": "^0.0.1",
    "@size-limit/preset-small-lib": "^12.0.1",
    "@types/node": "^25.3.5",
    "@vitest/coverage-v8": "^4.0.18",
    "check-dts": "^0.9.0",
    "eslint": "^10.0.3",
    "happy-dom": "^20.8.3",
    "nano-staged": "^0.9.0",
    "nanodelay": "^2.0.2",
    "nanostores": "^1.1.1",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "prettier": {
    "arrowParens": "avoid",
    "jsxSingleQuote": false,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "nano-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "size-limit": [
    {
      "path": "./index.js",
      "import": "{ logger }",
      "limit": "1408 B"
    }
  ],
  "clean-publish": {
    "cleanDocs": true
  }
}
